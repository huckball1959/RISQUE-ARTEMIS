/* ARTEMIS — host setup rig picker (login idle, before START) */
.risque-artemis-rig-picker {
  position: fixed;
  inset: 0;
  z-index: 100060;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(2, 6, 23, 0.92);
  backdrop-filter: blur(10px);
}

.risque-artemis-rig-picker[hidden] {
  display: none !important;
}

.risque-artemis-rig-picker-card {
  width: min(560px, 100%);
  padding: 32px 36px;
  border-radius: 18px;
  background: linear-gradient(165deg, #0f172a 0%, #1e293b 100%);
  border: 1px solid rgba(56, 189, 248, 0.35);
  box-shadow: 0 28px 72px rgba(0, 0, 0, 0.5);
  color: #f1f5f9;
}

.risque-artemis-rig-picker-title {
  margin: 0 0 10px;
  font-size: 28px;
  font-weight: 800;
  color: #38bdf8;
  text-align: center;
}

.risque-artemis-rig-picker-lead {
  margin: 0 0 24px;
  font-size: 16px;
  line-height: 1.5;
  color: #cbd5e1;
  text-align: center;
}

.risque-artemis-rig-picker-options {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.risque-artemis-rig-picker-btn {
  display: flex;
  align-items: center;
  gap: 16px;
  width: 100%;
  padding: 14px 18px;
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.85);
  color: #f8fafc;
  text-align: left;
  cursor: pointer;
  transition: border-color 0.15s ease, background 0.15s ease, transform 0.1s ease;
}

.risque-artemis-rig-picker-btn:hover {
  border-color: #38bdf8;
  background: rgba(30, 41, 59, 0.95);
  transform: translateY(-1px);
}

.risque-artemis-rig-picker-btn-num {
  flex: 0 0 36px;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #38bdf8;
  color: #0f172a;
  font-size: 18px;
  font-weight: 800;
}

.risque-artemis-rig-picker-btn-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.risque-artemis-rig-picker-btn-label {
  font-size: 17px;
  font-weight: 700;
}

.risque-artemis-rig-picker-btn-hint {
  font-size: 13px;
  color: #94a3b8;
  line-height: 1.35;
}


